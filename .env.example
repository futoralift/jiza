# ======================================================
# JIZA JEWELLERY STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# (Placeholders only — DO NOT commit actual secrets here)
# ======================================================

# Server Port & Environment
PORT=5000
NODE_ENV=production

# PostgreSQL Database Credentials
PGHOST=localhost
PGPORT=5432
PGDATABASE=jiza_store
PGUSER=your_postgres_user_here
PGPASSWORD=your_postgres_password_here

# Enterprise Admin Security Key & JWT Secret (Generate a random 64+ char string)
ADMIN_JWT_SECRET=your_random_jwt_secret_key_minimum_64_characters_here

# Allowed Origins for CORS (Comma-separated)
ALLOWED_ORIGINS=https://jizajewellerystudio.com,https://www.jizajewellerystudio.com,http://localhost:5173

# Razorpay Payment Gateway Keys
RAZORPAY_KEY_ID=rzp_test_or_live_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Transactional SMTP Email Service (Gmail / SMTP Relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_business_email@gmail.com
SMTP_PASSWORD=your_gmail_16_char_app_password_here
SMTP_FROM_NAME="Jiza Jewellery Studio"
SMTP_FROM_EMAIL=your_business_email@gmail.com

# Sentry Monitoring DSN (Optional)
VITE_SENTRY_DSN=
SENTRY_DSN=
