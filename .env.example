# ======================================================
# JIZA JEWELLERY STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# (Placeholders only — DO NOT commit actual secrets here)
# ======================================================

# Server Port & Environment
PORT=5000
NODE_ENV=production

# PostgreSQL Database Credentials
PGHOST=localhost
PGPORT=5432
PGDATABASE=jiza_store
PGUSER=your_postgres_user_here
PGPASSWORD=your_postgres_password_here

# Enterprise Admin Security Key & JWT Secret (Generate a random 64+ char string)
ADMIN_JWT_SECRET=your_random_jwt_secret_key_minimum_64_characters_here

# Initial Admin Accounts Setup (Optional Seed on First Boot)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PHONE=your_admin_phone_number_here
ADMIN_INITIAL_PASSWORD=your_secure_admin_initial_password_here
AGENCY_EMAIL=your_agency_email@example.com
AGENCY_PHONE=your_agency_phone_number_here
AGENCY_INITIAL_PASSWORD=your_secure_agency_initial_password_here

# Admin Multi-Factor & Development Tokens (Optional)
ADMIN_STATIC_OTP=your_6_digit_static_otp_here
DEV_ADMIN_TOKEN=your_dev_bypass_token_here

# Allowed Origins for CORS (Comma-separated)
ALLOWED_ORIGINS=https://jizajewellerystudio.com,https://www.jizajewellerystudio.com,http://localhost:5173

# Razorpay Payment Gateway Keys
RAZORPAY_KEY_ID=rzp_test_or_live_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Transactional SMTP Email Service (Gmail / SMTP Relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_business_email@gmail.com
SMTP_PASSWORD=your_gmail_16_char_app_password_here
SMTP_FROM_NAME="Jiza Jewellery Studio"
SMTP_FROM_EMAIL=your_business_email@gmail.com

# VPS Deployment Configuration (Optional - automated deploy scripts)
VPS_HOST=your_vps_ip_address_here
VPS_PORT=22
VPS_USER=root
VPS_PASSWORD=your_vps_ssh_password_here

# Sentry Monitoring DSN (Optional)
VITE_SENTRY_DSN=
SENTRY_DSN=
